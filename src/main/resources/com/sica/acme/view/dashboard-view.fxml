<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sica.acme.controller.DashboardController"
            stylesheets="@../styles/dashboard.css"
            prefWidth="1100"
            prefHeight="700"
            styleClass="dashboard-root">

    <!-- el encabezado -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="topbar">

            <Label text="SICA" styleClass="logo"/>

            <Label text="Sistema Integrado de Control de Acceso"
                   styleClass="topbar-subtitle"/>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT" spacing="3">
                <Label fx:id="lblNombre" styleClass="usuario-nombre"/>
                <Label fx:id="lblRol" styleClass="usuario-rol"/>
                <Label fx:id="lblCorreo" styleClass="usuario-correo"/>
            </VBox>

            <Button text="Cerrar sesiÃ³n"
                    onAction="#handleCerrarSesion"
                    styleClass="boton-sesion"/>
        </HBox>
    </top>

    <!-- Meni Lateral  -->
    <left>
        <VBox spacing="8" styleClass="sidebar">
            <Label text="MENÃš PRINCIPAL"
                   styleClass="menu-titulo"/>

            <Button fx:id="btnInicio"
                    text="Panel principal"
                    onAction="#handlePanelPrincipal"
                    styleClass="menu-button menu-button-active"/>

            <Label text="GESTIÃ“N"
                   styleClass="menu-separador"/>

            <Button text="Usuarios y roles"
                    onAction="#handleUsuarios"
                    styleClass="menu-button"/>

            <Button text="Empresas"
                    onAction="#handleEmpresas"
                    styleClass="menu-button"/>

            <Button text="Personas"
                    onAction="#handlePersonas"
                    styleClass="menu-button"/>

            <Label text="CONTROL DE ACCESO"
                   styleClass="menu-separador"/>

            <Button text="Visitas"
                    onAction="#handleVisitas"
                    styleClass="menu-button"/>

            <Button text="Aprobaciones"
                    onAction="#handleAprobaciones"
                    styleClass="menu-button"/>

            <Button text="Incidentes"
                    onAction="#handleIncidentes"
                    styleClass="menu-button"/>

            <Label text="CONSULTAS"
                   styleClass="menu-separador"/>

            <Button text="Reportes"
                    onAction="#handleReportes"
                    styleClass="menu-button"/>
        </VBox>
    </left>

    <!-- El contenido Central -->

<center>
    <StackPane fx:id="contenidoCentral">

        <VBox spacing="18" styleClass="contenido">
            <Label fx:id="lblTituloContenido"
                   text="Bienvenido a SICA"
                   styleClass="contenido-titulo"/>

            <Label fx:id="lblDescripcionContenido"
                   text="Sistema de control de acceso de Zona Acme."
                   wrapText="true"
                   styleClass="contenido-descripcion"/>

            <VBox spacing="10" styleClass="contenido-card">
                <Label text="PANEL DE INFORMACIÃ“N"
                       styleClass="card-titulo"/>

                <Label text="Selecciona una opciÃ³n del menÃº lateral para comenzar."
                       wrapText="true"
                       styleClass="card-texto"/>
            </VBox>
        </VBox>

    </StackPane>
</center>
</BorderPane>
