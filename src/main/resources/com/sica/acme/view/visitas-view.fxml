<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sica.acme.controller.VisitaController"
      stylesheets="@../styles/empresas.css"
      spacing="20"
      styleClass="empresas-root">

    <VBox spacing="6" styleClass="empresas-header">

        <Label text="Control de visitas"
               styleClass="titulo-seccion"/>

        <Label text="Registra, consulta y controla los ingresos y salidas de trabajadores e invitados."
               styleClass="descripcion-seccion"
               wrapText="true"/>

    </VBox>

    <HBox spacing="10">

        <Button fx:id="btnNuevaVisita"
                text="+ Nueva visita"
                onAction="#handleNuevaVisita"
                styleClass="boton-primario"/>

        <Button fx:id="btnAprobar"
                text="Aprobar"
                onAction="#handleAprobarVisita"
                styleClass="boton-secundario"/>

        <Button fx:id="btnRechazar"
                text="Rechazar"
                onAction="#handleRechazarVisita"
                styleClass="boton-secundario"/>

        <Button fx:id="btnEntrada"
                text="Registrar entrada"
                onAction="#handleRegistrarEntrada"
                styleClass="boton-secundario"/>

        <Button fx:id="btnSalida"
                text="Registrar salida"
                onAction="#handleRegistrarSalida"
                styleClass="boton-secundario"/>

        <Button fx:id="btnActualizar"
                text="Actualizar"
                onAction="#handleActualizar"
                styleClass="boton-secundario"/>

    </HBox>

    <VBox spacing="12"
          styleClass="empresas-card"
          VBox.vgrow="ALWAYS">

        <Label text="Visitas registradas"
               styleClass="titulo-seccion"/>

        <TableView fx:id="tablaVisitas"
                   styleClass="tabla-empresas"
                   VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="colId"
                             text="ID"
                             prefWidth="55"/>

                <TableColumn fx:id="colPersona"
                             text="Persona"
                             prefWidth="160"/>

                <TableColumn fx:id="colAnfitrion"
                             text="Anfitrión"
                             prefWidth="160"/>

                <TableColumn fx:id="colFecha"
                             text="Fecha programada"
                             prefWidth="180"/>

                <TableColumn fx:id="colEstado"
                             text="Estado"
                             prefWidth="180"/>

                <TableColumn fx:id="colPlaca"
                             text="Placa"
                             prefWidth="100"/>

            </columns>

        </TableView>

    </VBox>

</VBox>
